#!/bin/bash

upset() {
  # accepted forms:
  #   upset <remote> <branch>  -> use both as provided
  #   upset <branch>           -> default remote to origin
  #   upset                    -> default remote to origin, branch to current
  if [ -n "$2" ]; then
    REMOTE="$1"
    BRANCH="$2"
  elif [ -n "$1" ]; then
    REMOTE="origin"
    BRANCH="$1"
  else
    REMOTE="origin"
    BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
  fi

  # check that a branch could be determined
  if [ -z "$BRANCH" ]; then
    echo "could not determine the current branch and none was provided" >&2
    return 1
  fi

  git fetch "$REMOTE" "$BRANCH"
  git reset --hard FETCH_HEAD
}

feature() {
  BRANCH=pull/$(git rev-parse HEAD)

  git branch $BRANCH
  git push origin $BRANCH:$BRANCH
}

temp() {
  # generate a random hash
  HASH=$(date | sha256sum | awk '{print substr($1, 1, 40)}')

  git checkout -b "temp/$HASH"
}

workspace() {
  # henerate a random hash using the same method as temp()
  HASH=$(date | sha256sum | awk '{print substr($1, 1, 40)}')
  BRANCH="temp/$HASH"

  # create a temporary directory
  TEMP_DIR=$(mktemp -d -t "fit-${HASH}.XXXXXX") || {
    echo "Failed to create temporary directory" >&2
    return 1
  }

  # create a worktree with a new branch 
  git worktree add -b "$BRANCH" "$TEMP_DIR" || {
    rm -rf "$TEMP_DIR"
    echo "Failed to create worktree at: $TEMP_DIR" >&2
    return 1
  }

  # execute nvim in the temp directory
  env -C "$TEMP_DIR" nvim . || {
    git worktree remove "$TEMP_DIR" 2>/dev/null
    git branch -D "$BRANCH" 2>/dev/null
    rm -rf "$TEMP_DIR"
    echo "Failed to start claude" >&2
    return 1
  }
}

case "$1" in
  checkout|switch|push)
    git $@ -f
    ;;
  rebase)
    git reset --hard
    git $@
    ;;
  reset)
    git $@ --hard
    ;;
  clean)
    git clean -dfx
    ;;
  workspace)
    workspace
    ;;
  upset)
    upset "$2" "$3"
    ;;
  feature)
    feature
    ;;
  temp)
    temp
    ;;
  *)
    git $@
    ;;
esac
